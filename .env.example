# ceg-brain configuration. Copy to `.env` and fill in. `.env` is gitignored.

# ── Server ─────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
# Public base URL your apps will use (informational; used in logs/README).
PUBLIC_BASE_URL=https://brain.ceg.ag

# ── App keys (the "OpenAI API keys" your apps use) ─────────────────────
# Comma-separated list of  label:key  pairs. The label is for cost attribution.
# Generate keys with:  openssl rand -hex 24
BRAIN_KEYS=slack:sk-ceg-REPLACE_ME,onboarding:sk-ceg-REPLACE_ME

# ── Backend: which credential powers inference ─────────────────────────
# "subscription" = use the Claude subscription via the `ant` OAuth profile on this box.
# "api"          = use an Anthropic API key (the escape hatch / fallback).
BRAIN_BACKEND=subscription

# Only used when BRAIN_BACKEND=api
ANTHROPIC_API_KEY=

# Path to the `ant` CLI (installed by install.sh). Only used for subscription backend.
ANT_BIN=ant
# How often (minutes) to proactively refresh the subscription access token.
TOKEN_REFRESH_MIN=25

# ── Model + behaviour ──────────────────────────────────────────────────
# Default model when an app doesn't specify one (or maps an OpenAI-ish name to it).
DEFAULT_MODEL=claude-opus-4-8
ANTHROPIC_VERSION=2023-06-01
# Max simultaneous upstream calls — protects a single subscription from bursts.
MAX_CONCURRENCY=3
# Forward temperature/top_p from callers? Off by default (newer Claude models reject them).
FORWARD_SAMPLING=0
