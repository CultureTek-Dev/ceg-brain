# ceg-brain configuration. Copy to `.env` and fill in. `.env` is gitignored.

# ── Server ─────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
# Public base URL your apps will use (informational; used in logs/README).
PUBLIC_BASE_URL=https://brain.ceg.ag

# ── App keys (the "OpenAI API keys" your apps use) ─────────────────────
# Comma-separated list of  label:key  pairs. The label is for cost attribution.
# Generate keys with:  openssl rand -hex 24
BRAIN_KEYS=slack:sk-ceg-REPLACE_ME,onboarding:sk-ceg-REPLACE_ME

# ── Backend: which credential powers inference ─────────────────────────
#   "subscription" = your Claude Pro/Max subscription via the Claude Code OAuth
#                    token (`claude setup-token`). Draws on your subscription's
#                    Claude Code rate limits, NOT pay-as-you-go API credits.
#   "api"          = Anthropic API via a static key (pay-as-you-go).
# ⚠️ Anthropic's usage policy does not sanction pointing product/app traffic at a
#    personal subscription; the token can be rate-limited or revoked. See README.
BRAIN_BACKEND=subscription

# ── subscription backend ───────────────────────────────────────────────
# Generate on a machine with a browser:  claude setup-token  → sk-ant-oat01-…
# Long-lived (~1yr). Keep this file chmod 600. Do NOT also set ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=
# anthropic-beta header sent with the OAuth token (comma-separated for multiple).
ANTHROPIC_BETA=oauth-2025-04-20
# Prepend the Claude Code identity system block so the OAuth token is accepted.
# Leave on — turning it off gets the token rejected. (1=on, 0=off)
INJECT_CLAUDE_CODE_SYSTEM=1

# Legacy fallback: if CLAUDE_CODE_OAUTH_TOKEN is empty, source a token from the
# `ant` CLI OAuth profile instead. Path to the CLI + refresh cadence (minutes).
ANT_BIN=ant
TOKEN_REFRESH_MIN=25

# ── api backend ────────────────────────────────────────────────────────
# Required only when BRAIN_BACKEND=api  (get one at console.anthropic.com)
ANTHROPIC_API_KEY=

# ── Model + behaviour ──────────────────────────────────────────────────
# Default model when an app doesn't specify one (or maps an OpenAI-ish name to it).
DEFAULT_MODEL=claude-opus-4-8
ANTHROPIC_VERSION=2023-06-01
# Max simultaneous upstream calls — protects a single subscription from bursts.
MAX_CONCURRENCY=3
# Forward temperature/top_p from callers? Off by default (newer Claude models reject them).
FORWARD_SAMPLING=0

# ── Web search (server-side tool) ──────────────────────────────────────
# Per-request: {"web_search": true} or {"model": "research"}. Off otherwise.
WEB_SEARCH_TOOL_TYPE=web_search_20260209
WEB_SEARCH_MAX_USES=8
WEB_SEARCH_MAX_CONTINUATIONS=4
WEB_SEARCH_APPEND_SOURCES=1
